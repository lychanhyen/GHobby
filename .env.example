# Kết nối cơ sở dữ liệu PostgreSQL (Supabase URI)
# Ví dụ: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/ghobby?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/ghobby?schema=public"

# Supabase Storage & API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-secret-service-role-key-never-share"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Bảo mật quản trị viên
ADMIN_INITIAL_PASSWORD="Admin@123456ChangeMeNow"
JWT_SECRET="ghobby-super-secret-jwt-key-2026-secure-random"

# Cấu hình thanh toán VietQR ngân hàng MB
