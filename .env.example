# ==============================================================================
# GHOBBY - CẤU HÌNH MÔI TRƯỜNG MẪU (.env.example)
# ==============================================================================

# 1. Cơ sở dữ liệu Supabase PostgreSQL
# Dùng chuỗi kết nối từ Supabase: Project Settings -> Database -> Connection String (URI)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Cơ sở dữ liệu riêng để chạy test tự động (tên DB bắt buộc chứa chữ 'test')
TEST_DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/ghobby_test"

# Cờ sử dụng dữ liệu mẫu cho dev local (đặt "true" để chạy demo khi chưa có DB)
USE_SAMPLE_DATA="true"

# 2. Supabase Storage (Lưu ảnh sản phẩm)
# Lấy từ Project Settings -> API
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_SECRET_KEY]"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_PUBLIC_KEY]"

# 3. Bảo mật Quản trị viên
ADMIN_INITIAL_PASSWORD="Admin@123456ChangeMeNow"
JWT_SECRET="ghobby-super-secure-random-jwt-secret-key-32-chars-min"
CRON_SECRET="ghobby-cron-secret-key-for-24h-auto-cancel"

# 4. Cấu hình Cửa Hàng & Thanh Toán VietQR
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SHOP_NAME="GHobby"
NEXT_PUBLIC_SHOP_ADDRESS="Việt Nam"
NEXT_PUBLIC_SHOP_HOTLINE="0905.123.456"
NEXT_PUBLIC_SHOP_EMAIL="support@ghobby.vn"

# Ngân hàng nhận cọc (Mã chuẩn Napas: MB)
NEXT_PUBLIC_SHOP_BANK_ID="MB"
NEXT_PUBLIC_SHOP_BANK_ACCOUNT=""
NEXT_PUBLIC_SHOP_BANK_NAME=""

# Vận chuyển
NEXT_PUBLIC_OUTER_CITY_SHIPPING_FEE="20000"
NEXT_PUBLIC_INNER_CITY_DISTRICTS="Hải Châu,Thanh Khê,Sơn Trà,Ngũ Hành Sơn,Cẩm Lệ,Liên Chiểu"
